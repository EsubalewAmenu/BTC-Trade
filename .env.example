# Read-only account data. Create a fresh API key with withdrawals and trading disabled.
BINANCE_API_KEY=
BINANCE_SECRET_KEY=
REQUIRE_BINANCE_ACCOUNT=true

# LLM decision service. Enter both keys, then select the provider.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.7-flash
USE_GEMINI=false
REQUIRE_LLM=true

TRADE_SYMBOL=BTCUSDT
STRATEGY_MODE=scalp
TRADE_INTERVAL=5m
TREND_INTERVAL=15m
POLL_SECONDS=10
MAX_CONSECUTIVE_ERRORS=20
CANDLE_LIMIT=250

PAPER_START_BALANCE=500
RISK_PER_TRADE=0.005
MAX_DAILY_LOSS=0.02
MAX_TRADES_PER_DAY=12
MAX_LEVERAGE=3
STOP_ATR=1.2
REWARD_RISK=1.5
MAX_HOLD_MINUTES=60
COOLDOWN_MINUTES=10
TAKER_FEE_RATE=0.0005
SLIPPAGE_BPS=2
MIN_LLM_CONFIDENCE=0.70

RSI_PERIOD=14
STOCH_PERIOD=14
STOCH_K=3
STOCH_D=3
STOCH_OVERSOLD=35
STOCH_OVERBOUGHT=65
EMA_FAST=20
EMA_SLOW=50
ATR_PERIOD=14

TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=
LOG_LEVEL=INFO
