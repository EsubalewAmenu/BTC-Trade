# Optional read-only Binance account data. Trading and withdrawals must remain disabled.
BINANCE_API_KEY=
BINANCE_SECRET_KEY=
REQUIRE_BINANCE_ACCOUNT=false

# LLM decisions. Any invalid/missing response is recorded as WAIT.
DECISION_MODE=llm
LLM_ENDPOINT_URL=https://63aghx6yiwuo5m3hwlxxsywwb40lwpyg.lambda-url.us-east-1.on.aws/
LLM_TIMEOUT_SECONDS=60
LLM_MIN_CONFIDENCE=70
LLM_MAX_ENTRY_DEVIATION_BPS=20
# Temporary development logging. Set false when the integration is stable.
LOG_EXTERNAL_RESPONSES=true

TRADE_SYMBOL=BTCUSDT
STRATEGY_VARIANT=breakout_retest
TRADE_INTERVAL=15m
TREND_INTERVAL=1h
CONTEXT_INTERVAL=4h
# Analyze once, 20 seconds after the expected close of the next candle.
CANDLE_CLOSE_DELAY_SECONDS=20
# Mark-price checks continue while a paper position is open.
POSITION_POLL_SECONDS=10
MAX_CONSECUTIVE_ERRORS=20
CANDLE_LIMIT=300

# Deterministic pullback definition.
EMA_FAST=20
EMA_SLOW=50
ATR_PERIOD=14
TREND_SLOPE_BARS=3
MINIMUM_TREND_SEPARATION_ATR=0
BREAKOUT_LOOKBACK=10
IMPULSE_ATR=1.0
PULLBACK_MIN_BARS=2
PULLBACK_MAX_BARS=6
PULLBACK_TOUCH_ATR=0.25
PULLBACK_MAX_RETRACE=0.8
PULLBACK_MIN_DEPTH=0.35
PULLBACK_MAX_DEPTH=1.15
CONFIRMATION_LOOKBACK=2
CONFIRMATION_CLOSE_FRACTION=0.65

# Paper execution and risk.
PAPER_START_BALANCE=500
RISK_PER_TRADE=0.005
MAX_DAILY_LOSS=0.02
MAX_TRADES_PER_DAY=12
MAX_LEVERAGE=3
STOP_ATR=1.0
STOP_BUFFER_ATR=0.15
REWARD_RISK=1.5
MINIMUM_NET_REWARD_RISK=1.1
BREAKEVEN_TRIGGER_R=1.0
MAX_HOLD_MINUTES=105
COOLDOWN_MINUTES=10
TAKER_FEE_RATE=0.0005
SLIPPAGE_BPS=2

TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=
LOG_LEVEL=INFO
