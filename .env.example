# Read-only account data. Create a fresh API key with withdrawals and trading disabled.
BINANCE_API_KEY=
BINANCE_SECRET_KEY=
REQUIRE_BINANCE_ACCOUNT=true

# LLM decision service. Enter both keys, then select the provider.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.7-flash
USE_GEMINI=false
REQUIRE_LLM=true

TRADE_SYMBOL=BTCUSDT
TRADE_INTERVAL=15m
TREND_INTERVAL=1h
POLL_SECONDS=15
CANDLE_LIMIT=250

PAPER_START_BALANCE=500
RISK_PER_TRADE=0.005
MAX_DAILY_LOSS=0.02
MAX_TRADES_PER_DAY=4
MAX_LEVERAGE=3
STOP_ATR=1.2
REWARD_RISK=1.8
MAX_HOLD_MINUTES=240
COOLDOWN_MINUTES=30
TAKER_FEE_RATE=0.0005
SLIPPAGE_BPS=2
MIN_LLM_CONFIDENCE=0.70

RSI_PERIOD=14
STOCH_PERIOD=14
STOCH_K=3
STOCH_D=3
STOCH_OVERSOLD=20
STOCH_OVERBOUGHT=80
EMA_FAST=20
EMA_SLOW=50
ATR_PERIOD=14

TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=
LOG_LEVEL=INFO
